{
  "name": "Workshop Vertex AI (Angular + Flutter)",
  "image": "ghcr.io/cirruslabs/flutter:stable",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "forwardPorts": [4200, 8080],
  "portsAttributes": {
    "8080": {
      "label": "Flutter Web",
      "onAutoForward": "openBrowser"
    },
    "4200": {
      "label": "Angular App",
      "onAutoForward": "openBrowser"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.flutter",
        "Dart-Code.dart-code",
        "Angular.ng-template"
      ]
    }
  },
  "postCreateCommand": "flutter config --enable-web && npm install -g @angular/cli && echo 'alias run-flutter=\"flutter run -d web-server --web-port 8080 --web-hostname 0.0.0.0\"' >> ~/.bashrc"
}